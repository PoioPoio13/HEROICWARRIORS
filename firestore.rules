rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Progreso de cada jugador: solo su dueño puede leerlo y escribirlo.
    match /players/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Ranking público: cualquiera puede leer; solo el dueño escribe su propia fila, con límites razonables.
    // OJO: el juego corre en el móvil, así que un tramposo técnico podría falsear su puntuación.
    // Estos límites solo frenan las trampas más tontas (números gigantes, nombres enormes).
    match /leaderboard/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.wins is number && request.resource.data.wins >= 0 && request.resource.data.wins <= 100000
        && request.resource.data.matches is number && request.resource.data.matches >= 0 && request.resource.data.matches <= 100000
        && request.resource.data.kills is number && request.resource.data.kills >= 0 && request.resource.data.kills <= 1000000
        && request.resource.data.bestStreak is number && request.resource.data.bestStreak >= 0 && request.resource.data.bestStreak <= 100000;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
